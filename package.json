{
  "name": "fitment",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm mobile",
    "mobile": "pnpm --filter @fitment/mobile start",
    "ios": "pnpm --filter @fitment/mobile ios",
    "export:ios": "pnpm --filter @fitment/mobile export:ios",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm test:engine",
    "clean:test-dist": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "test:engine": "pnpm clean:test-dist && tsc -p tsconfig.engine.json && node --test tests/*.test.mjs",
    "check": "pnpm test:engine && pnpm --filter @fitment/mobile typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
